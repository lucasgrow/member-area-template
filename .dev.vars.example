# Required - generated automatically by `bun run setup`
APP_NAME=My Academy
APP_DOMAIN=members.example.com
ADMIN_EMAIL=owner@example.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@yourdomain.com

# Optional - leave empty when billing is manual-only
BILLING_WEBHOOK_SECRET=

# Optional - only needed for presigned R2 uploads
# Get credentials: Cloudflare dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Google OAuth redirect URI:
# http://localhost:3000/api/auth/callback/google
